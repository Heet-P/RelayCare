{
  "name": "relaycare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "demo:reset": "tsx --conditions=react-server scripts/demo-reset.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "video": "remotion studio",
    "video:render": "remotion render LaunchVideo out/relaycare-launch-1080p.mp4 && remotion render LaunchVideo out/relaycare-launch-4k.mp4 --scale=2",
    "video:score": "tsx remotion/score.ts",
    "demo:voice": "tsx scripts/demo/voice.ts",
    "demo:record": "tsx scripts/demo/record.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@nexconn/chat": "26.2.1",
    "@nexconn/engine": "26.2.1",
    "@number-flow/react": "^0.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.9.1",
    "input-otp": "^1.5.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.69.0",
    "mapbox-gl": "^3.34.2",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@remotion/cli": "^4.0.541",
    "@remotion/google-fonts": "^4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/tailwind-v4": "^4.0.541",
    "@remotion/transitions": "^4.0.541",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "remotion": "^4.0.541",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
