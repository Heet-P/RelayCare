# Copy to .env.local and fill in. NEVER commit real values.

# Public base URL of this app (tunnel URL in dev, Vercel URL in prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler (port 6543) for the app; direct/session (5432) for migrations
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Nexconn (Console → App). The secret is server-only.
NEXT_PUBLIC_NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_PRIMARY=https://api.sg-light-api.com
NEXCONN_API_BACKUP=
# SDK data centre: SG | NA | SAU ... (see AreaCode in @nexconn/chat)
NEXT_PUBLIC_NEXCONN_AREA=SG

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Shared secret for /api/jobs/run (pg_cron + local worker)
CRON_SECRET=

# Email (Resend) and maps (Mapbox) — Phase 7
RESEND_API_KEY=
EMAIL_FROM=RelayCare <support@example.com>
NEXT_PUBLIC_MAPBOX_TOKEN=
